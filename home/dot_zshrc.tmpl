export EDITOR="code --wait"
export VISUAL="$EDITOR"

alias g="git"

# Keep interactive startup declarative and framework-free. Automation belongs in Bash.
# Preserve a local history when Atuin is unavailable. Atuin remains responsible
# for interactive search and cross-terminal history synchronization.
HISTFILE="${ZDOTDIR:-$HOME}/.zsh_history"
HISTSIZE=50000
SAVEHIST=50000
setopt inc_append_history
setopt hist_expire_dups_first
setopt hist_ignore_dups
setopt hist_ignore_space
setopt hist_reduce_blanks

if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate zsh)"
fi

autoload -Uz compinit
compinit

if command -v brew >/dev/null 2>&1; then
  FZF_SHELL_DIR="$(brew --prefix fzf 2>/dev/null)/shell"
elif [[ -d /usr/share/doc/fzf/examples ]]; then
  FZF_SHELL_DIR="/usr/share/doc/fzf/examples"
fi

if [[ -n "${FZF_SHELL_DIR:-}" ]]; then
  [[ -f "$FZF_SHELL_DIR/key-bindings.zsh" ]] && source "$FZF_SHELL_DIR/key-bindings.zsh"
  [[ -f "$FZF_SHELL_DIR/completion.zsh" ]] && source "$FZF_SHELL_DIR/completion.zsh"
fi
unset FZF_SHELL_DIR

if command -v starship >/dev/null 2>&1; then
  eval "$(starship init zsh)"
fi

if command -v atuin >/dev/null 2>&1; then
  eval "$(atuin init zsh)"
fi

if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init zsh)"
fi

if [[ -f "$HOME/.config/shell/local.zsh" ]]; then
  source "$HOME/.config/shell/local.zsh"
fi

if command -v eza >/dev/null 2>&1; then
  alias ll="eza -lah --git --group-directories-first"
else
  alias ll="ls -lah"
fi
if ! command -v bat >/dev/null 2>&1 && command -v batcat >/dev/null 2>&1; then
  alias bat="batcat"
fi

if command -v brew >/dev/null 2>&1; then
  ZSH_AUTOSUGGESTIONS="$(brew --prefix zsh-autosuggestions 2>/dev/null)/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
  ZSH_SYNTAX_HIGHLIGHTING="$(brew --prefix zsh-syntax-highlighting 2>/dev/null)/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
else
  ZSH_AUTOSUGGESTIONS="/usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
  ZSH_SYNTAX_HIGHLIGHTING="/usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
fi

[[ -f "$ZSH_AUTOSUGGESTIONS" ]] && source "$ZSH_AUTOSUGGESTIONS"
# zsh-syntax-highlighting must be loaded after all widgets and key bindings.
[[ -f "$ZSH_SYNTAX_HIGHLIGHTING" ]] && source "$ZSH_SYNTAX_HIGHLIGHTING"
unset ZSH_AUTOSUGGESTIONS ZSH_SYNTAX_HIGHLIGHTING
