{{- $profile := promptChoiceOnce . "profile" "Select a profile" (list "common" "personal") -}}
{{- $gitName := promptStringOnce . "gitName" "Git user name" -}}
{{- $gitEmail := promptStringOnce . "gitEmail" "Git email address" -}}
[data]
profile = {{ $profile | quote }}
gitName = {{ $gitName | quote }}
gitEmail = {{ $gitEmail | quote }}
