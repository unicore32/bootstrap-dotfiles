#!/usr/bin/env bash
set -euo pipefail

if [ "${ALLOW_MAIN_PUSH:-0}" = "1" ]; then
  exit 0
fi

while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/master)
      echo "[BLOCKED] Direct push to $remote_ref is disabled by local policy."
      echo "Use a feature branch and open a PR instead."
      echo "If this is intentional, run: ALLOW_MAIN_PUSH=1 git push ..."
      exit 1
      ;;
  esac
done

exit 0
